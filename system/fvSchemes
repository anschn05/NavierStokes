FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         backward;   // stabil (alternativ: Euler)
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;

    // Konvektionsterm für Impuls: stabil + nicht zu diffusive
    div(phi,U)      Gauss limitedLinearV 1;

}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

fluxRequired
{
    default         no;
    p;
}

